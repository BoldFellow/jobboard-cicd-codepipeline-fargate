{
  "family": "ENVIRONMENT_NAME-applications-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "EXECUTION_ROLE_ARN_PLACEHOLDER",
  "taskRoleArn": "TASK_ROLE_ARN_PLACEHOLDER",
  "containerDefinitions": [
    {
      "name": "applications-api",
      "image": "<IMAGE_APPS_NAME>",
      "portMappings": [
        {"containerPort": 8081, "protocol": "tcp"}
      ],
      "environment": [
        {"name": "APPLICATIONS_TABLE", "value": "APPLICATIONS_TABLE_PLACEHOLDER"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "AWSLOGS_GROUP_PLACEHOLDER",
          "awslogs-region": "REGION_PLACEHOLDER",
          "awslogs-stream-prefix": "applications-api"
        }
      }
    }
  ]
}
